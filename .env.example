# 复制为 .env 后按需填写；本项目不会自动加载 .env，
# 请在 PowerShell 中显式设置环境变量（见 AI与大数据/02-技术栈与运行环境.md）。

# DeepSeek（可选）：不配置则使用抽取式引用，不调用大模型
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# GitHub（可选）：提高 API 配额 60 -> 5000 次/小时
GITHUB_TOKEN=

# 可选：覆盖数据目录
# RAG_DATA_DIR=D:\test\data
# RAG_ARTIFACT_DIR=D:\test\examples\generated
